# Volcengine Doubao API Configuration
DOUBAO_API_KEY="your-api-key-here"
DOUBAO_MODEL_ENDPOINT="your-model-endpoint-here"
DOUBAO_BOT_ID="your-bot-id-here"
DOUBAO_VISION_ENDPOINT="your-vision-endpoint-here"
DOUBAO_EMBEDDING_ENDPOINT="your-embedding-endpoint-here"

# uvicorn server host/port
HOST=127.0.0.1
PORT=8000
API_PREFIX=""

# CORS 白名单（逗号分隔）
# 包含解析后的根域名和 www 子域名，支持 http 和 https
ALLOWED_ORIGINS=http://zhongyidazhinengzhushou.cn,https://zhongyidazhinengzhushou.cn,http://www.zhongyidazhinengzhushou.cn,https://www.zhongyidazhinengzhushou.cn

# JWT Security Configuration
JWT_SECRET_KEY="generate-a-long-random-secret-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 生产环境数据库路径
DATABASE_URL="sqlite:///./data/prod.db"
