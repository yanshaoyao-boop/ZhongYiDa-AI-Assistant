# Volcengine Doubao API Configuration (Used for Embedding & Vision)
DOUBAO_API_KEY="your-doubao-api-key-here"
DOUBAO_MODEL_ENDPOINT="your-model-endpoint-here"
DOUBAO_DOCUMENT_MODEL_ENDPOINT="your-document-model-endpoint-here"
DOUBAO_EMBEDDING_ENDPOINT="your-embedding-endpoint-here"
DOUBAO_BOT_ID="your-bot-id-here"

# MiniMax API Configuration (Used for Main Brain/Chat)
MINIMAX_API_KEY="your-minimax-api-key-here"
MINIMAX_MODEL="MiniMax-M2.7"

# uvicorn server host/port
HOST=0.0.0.0
PORT=8001


# API 路径前缀。如果 Nginx 层面剥离了 /api/，请将此项设为空字符串 ""
API_PREFIX=""
